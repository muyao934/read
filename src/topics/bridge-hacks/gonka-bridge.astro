// 桥合约：换锁芯的函数（节选，去掉注释和校验语句之间的空行）
const SUBMIT = `function submitGroupKey(
    uint64 epochId,
    bytes calldata groupPublicKey,
    bytes calldata validationSig
) public onlyNormalOperation {              // 没有 onlyOwner：任何地址都能调
    require(epochId > 1, "Epoch 1 must be set via Admin");
    if (epochId != epochMeta.latestEpochId + 1) revert InvalidEpochSequence();
    require(groupPublicKey.length == 256, "Invalid group key length");
    GroupKey memory newGroupKeyStruct = _bytesToGroupKey(groupPublicKey);
    GroupKey memory prevGroupKeyStruct = epochGroupKeys[epochId - 1];
    require(!_isGroupKeyEmpty(prevGroupKeyStruct), "Previous epoch not found");
    // 唯一的门槛：上一轮的群公钥，对“这把新公钥”签过字
    require(_verifyTransitionSignature(prevGroupKeyStruct, newGroupKeyStruct,
        validationSig, epochId - 1), "Invalid transition signature");
    epochGroupKeys[epochId] = newGroupKeyStruct;`;

// Gonka 链：判定一个发牌人是否可信
const QUORUM = `quorumSlots := effectiveTotalSlots/2 + 1        // 100/2 + 1 = 51

var validVotingSlots uint64
validVotingSlots = dealerOwnSlots              // 自己那几片，默认算自己可信
for verifierIndex, verification := range epochBLSData.VerificationSubmissions {
    if verification == nil || len(verification.DealerValidity) == 0 {
        continue                               // 交不上报告的，直接跳过，不算反对票
    }
    ...
    validVotingSlots += verifierSlots
}
dealerIsValid := effectiveTotalSlots > 0 && validVotingSlots >= quorumSlots`;

