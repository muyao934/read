    { c: "“API”：Serif Digits 不管字母，往下找到 Georgia。实测 Georgia。",
      set: { msg: { h: chip("API", "--accent") }, r2: { hide: 0 } }, lit: ["st", "rs"] },
    { c: "“年”这些汉字：Serif Digits、Georgia 都没有，一直找到第三个 Songti SC（宋体）。实测 STSongti-SC-Regular。",
      set: { msg: { h: chip("汉字", "--accent") }, r3: { hide: 0 } }, lit: ["st", "rs"] },
    { c: "意外的是弯引号“”：Georgia 里有这两个字符，所以它们用的是 Georgia 的西文引号，不是宋体的。实测页面写了 lang=\"zh-CN\" 也一样：挑字体先看谁有这个字，语言管不到这里。",
      set: { msg: { h: chip("“ ”", "--warn") }, r4: { hide: 0 } }, bad: ["rs"] },
    { c: "全角的逗号、句号 Georgia 没有，落到宋体。所以同一行里实测用了三个字体：Times、Georgia、宋体。西文字体排在前面，是为了让字母和数字用西文字体；中文字体排在后面，接住剩下的。",
      set: { msg: { h: chip("，。", "--accent") }, r5: { hide: 0 } }, lit: ["rs"] },
  ],
};

// 行高：一行 28px 怎么分；不带单位的行高继承的是倍数，带 em 的继承的是算好的像素
const LH = {
  h: 300,
  b: [["one", 2, 8, 30, 84, "一行"], ["un", 35, 8, 30, 84, "父元素 1.75"], ["em", 68, 8, 30, 84, "父元素 1.75em"]],
  it: [
    { id: "o1", h: chip("16px · 1.75", "--muted", "out"), x: 17, y: 30 },
    { id: "o2", h: lbl("行高 28<br>上下各留 6", "m"), x: 17, y: 62, hide: 1 },
    { id: "u1", h: chip("h1 32px", "--muted", "out"), x: 50, y: 30, hide: 1 },
    { id: "u2", h: lbl("行高 56<br>两行 112", "g"), x: 50, y: 62, hide: 1 },
    { id: "e1", h: chip("h1 32px", "--muted", "out"), x: 83, y: 30, hide: 1 },
    { id: "e2", h: lbl("行高 28<br>两行 56：叠住", "w"), x: 83, y: 62, hide: 1 },
  ],
  s: [
    { c: "这个站的正文是 16px，行高 1.75：一行占 28px。", lit: ["one"] },
    { c: "28 比字号多出 12。CSS 把多出来的（叫 leading）对半分，上下各加 6，字落在一行的正中间。所以行高越大，行与行之间越松，字本身不变大。",
      set: { o2: { hide: 0 } }, lit: ["one"] },
    { c: "不带单位的 1.75，子元素继承的是“1.75 倍”这个数。h1 是 32px，自己再乘一遍：行高 56。实测一个折成两行的 h1，高 112。",
      set: { u1: { hide: 0 }, u2: { hide: 0 } }, lit: ["un"] },
    { c: "换成 1.75em：在父元素那里就算成了 28px，子元素继承的是 28px 这个结果。32px 的字挤在 28px 的行里，实测两行只有 56 高，上下两行的字叠在一起。所以行高写不带单位的数。",
      set: { e1: { hide: 0 }, e2: { hide: 0 } }, bad: ["em"] },
    { c: "line-height: normal 又不一样：行高取自字体文件里的上伸、下伸和行距。实测 16px 时宋体一行 22px，Georgia 一行 19px：字体不同，行高就不同，混排时行距忽大忽小。所以正文总写一个具体的数。",
      set: { o1: { h: chip("normal", "--doubt") }, o2: { h: lbl("宋体 22<br>Georgia 19", "w") } }, bad: ["one"] },
    { c: "写了具体的数，也有撑开的时候：sup 默认往上挪（vertical-align: super），它的行框跟着上移，把整行撑高。实测两行的段落多了 3.3px。区块链各页的脚注引用写了 line-height: 0，就是为了这个。",
      set: { o1: { h: chip("sup", "--doubt") }, o2: { h: lbl("56 → 59.3", "w") } }, bad: ["one"] },
  ],
};

// 对比度怎么算：拿这个站最接近门槛的一对（浅色主题 --ok 字在 --paper 底上）走一遍 WCAG 2 的公式
const CONTRAST = {
  h: 300,
  b: [["fg", 2, 8, 30, 84, "字 #2b7a4b"], ["cal", 35, 8, 30, 84, "相对亮度"], ["res", 68, 8, 30, 84, "对比度"]],
