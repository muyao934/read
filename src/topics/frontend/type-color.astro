---
// 前端与设计 · 第 2 章（概念类）：why → core → how → size → mix → digits → contrast → theme → example → pitfalls → sources
// 2026-11-10 在本机 Chrome 157（headless）里实测：CSS.getPlatformFontsForNode 看每段字用了哪个字体，canvas 量数字的墨迹，
// 测试页量行高和宽度，按 WCAG 2 公式算这个站的配色，HTML 分两段发看主题闪不闪，截图数像素看 font-display
import { Section, Note, Cards, Card, Flow, Table, Code, Anim, Sources } from "../../components/index.js";
import { chip, lbl } from "../../lib/anim.js";

// 一行字怎么挑字体：按 font-family 的顺序，一个字一个字地找“谁有这个字”
const FALLBACK = {
  h: 300,
  b: [["tx", 2, 8, 30, 84, "这一行字"], ["st", 35, 8, 30, 84, "按顺序找"], ["rs", 68, 8, 30, 84, "实际用上"]],
  it: [
    { id: "msg", h: chip("2026 年的 API", "--muted", "out"), x: 17, y: 30 },
