    { id: "f1", h: lbl("43 · 122 · 75", "m"), x: 17, y: 30 },
    { id: "f2", h: lbl("÷255，去伽马<br>.024 .195 .070", "m"), x: 17, y: 60, hide: 1 },
    { id: "w", h: lbl("R×.2126<br>G×.7152<br>B×.0722", "m"), x: 50, y: 34, hide: 1 },
    { id: "lf", h: lbl("字 L = 0.149", "m"), x: 50, y: 66, hide: 1 },
    { id: "lb", h: lbl("底 L = 0.930", "m"), x: 50, y: 82, hide: 1 },
    { id: "r1", h: lbl("(0.930+0.05)<br>÷ (0.149+0.05)", "m"), x: 83, y: 38, hide: 1 },
    { id: "r2", h: lbl("4.91 : 1", "g"), x: 83, y: 70, hide: 1 },
  ],
  s: [
    { c: "这个站浅色主题里，“成功”的绿字 --ok 写在页面底色 --paper 上。它是所有文字配色里对比度最低的一对，拿它走一遍 WCAG 2 的公式。", lit: ["fg"] },
