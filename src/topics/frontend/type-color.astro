    { id: "stk", h: lbl("1 Serif Digits<br>2 Georgia<br>3 Songti SC", "m"), x: 50, y: 62 },
    { id: "r1", h: lbl("2026 → Times", "g"), x: 83, y: 30, hide: 1 },
    { id: "r2", h: lbl("API → Georgia", "g"), x: 83, y: 45, hide: 1 },
    { id: "r3", h: lbl("汉字 → 宋体", "g"), x: 83, y: 60, hide: 1 },
