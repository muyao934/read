const FLOWSRC = `// Flow.astro 的前半段，构建时执行：先查 props，不对就让整个构建失败
const { items } = Astro.props;
if (!Array.isArray(items) || items.length < 2 || items.length > 5)
  throw new Error("Flow 要有 2–5 项（iPad 竖屏上 6 项会太窄），多了改用 Steps");
for (const i of items)
  if (!((i.kind || "") in KIND)) throw new Error(\`Flow 的 kind 只能是 tip / doubt / warn / ok，不能是 \${i.kind}\`);`;

const SSRHTML = `<main><p>第 <!-- -->0<!-- --> 段：这一段是正文……</p><p>第 <!-- -->1<!-- --> 段：……</p>…
// renderToString 的输出：JSX 里“第 {i} 段”是三段文字，HTML 会把它们连成一段，
// 所以 React 在中间插了注释当分隔，hydrate 时才对得上每一段文字归谁`;

const STEPS = `const STEP = 96, MOVE = 24;                       // 每步 3.2 秒，移动 0.8 秒（每秒 30 帧）
const ease = Easing.bezier(0.6, 0.05, 0.3, 1);      // 和网页上 transition 用的同一条曲线

export const Steps = () => {
  const frame = useCurrentFrame();                  // 第几帧：渲染时由 Remotion 给
  const k = Math.min(Math.floor(frame / STEP), d.s.length - 1);   // 第几步
  const t = frame - k * STEP;                       // 这一步开始后的第几帧
  const now = stateAt(d, k), before = stateAt(d, k - 1);         // 同动画引擎的 show()：从第 0 步累加
  const p = interpolate(t, [0, MOVE], [0, 1], { extrapolateRight: "clamp", easing: ease });
  // 每个元素：x = before.x + (now.x - before.x) × p；透明度同理。JSX 从略
};`;

