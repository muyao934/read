      set: { m1: { h: lbl("被脚本占住<br>1.2 秒", "w") }, L: { h: chip("left 停住", "--warn") }, T: { x: 86 } }, bad: ["mt"] },
    { c: "transform 那个照常动，71 帧每帧走 2.5px，一帧不少：合成线程不等主线程。同样的 transform 要是写在 requestAnimationFrame 里由脚本每帧去改，实测也停住了：回调要主线程来跑。",
      set: { T: { x: 76, h: chip("transform", "--ok") } }, lit: ["ct"] },
    { c: "脚本一结束，left 那个一帧跳了 83px，追上该在的位置。用户看到的是：卡住 1.2 秒，然后猛地一闪。所以页面在干重活时还要动的东西（加载转圈、进度），用 CSS 的 transform 和 opacity 来做。",
      set: { m1: { h: lbl("空下来", "g") }, L: { x: 74, h: chip("left 跳 83px", "--warn") }, T: { x: 74 } }, lit: ["mt", "sc"] },
