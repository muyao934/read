// 主线程被占住时：left 动画停住，CSS 的 transform 动画照常；数字来自 screencast 收到的合成器帧
const THREAD = {
  h: 300,
  b: [["mt", 2, 8, 46, 40, "主线程"], ["ct", 2, 52, 46, 40, "合成线程"], ["sc", 52, 8, 46, 84, "屏幕上，每 16.7 ms 一帧"]],
