};

const DIAGCSS = `/* base.css：图里只用语义类，颜色全是变量，深浅色跟着换 */
.d-box { fill: var(--sheet); stroke: var(--ink-3); stroke-width: 1.2; }
.d-line { stroke: var(--ink-3); stroke-width: 1.4; fill: none; }
.d-t { fill: var(--ink); font-size: 14px; }
.diagram svg { width: 100%; height: auto; min-width: 600px; }   /* 窄屏在框里滑动 */

/* lib.css：最宽 = viewBox 宽 × 16/14，14 单位的字最大显示成 16px（--vbw 由 Diagram 组件在构建时写入） */
.diagram svg { max-width: calc(var(--vbw) * 1px * 16 / 14); }`;

const ENGINE = `/* components.css：动画里的元素按画面的百分比定位，换位置时靠 transition 滑过去 */
.mini .it { position: absolute; transform: translate(-50%, -50%);
  transition: left .8s cubic-bezier(.6, .05, .3, 1), top .8s cubic-bezier(.6, .05, .3, 1), opacity .5s; }

// anim-engine.js：每一步只改 left、top（百分比）和 class
e.style.left = v.x + "%"; e.style.top = v.y + "%";`;

const SOURCES = [
