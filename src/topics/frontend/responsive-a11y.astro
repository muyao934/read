const META = `<!-- 这个站每一页 head 里的第二行 -->
<meta name="viewport" content="width=device-width, initial-scale=1">`;

const BREAKCSS = `/* base.css：版心两侧留白随宽度连续变，640 以下固定 16 */
.wrap { max-width: 1600px; padding: 0 clamp(48px, 6vw, 96px); }
@media (max-width: 640px) { .wrap { padding: 0 16px; } }
/* 标题字号也随宽度连续变：30px 到 46px 之间取 4.6vw */
.case-head h1 { font-size: clamp(30px, 4.6vw, 46px); }
/* 目录栏 180 + 间隙 32；960 以下目录挪到正文上面，横排 */
.case-body { grid-template-columns: 180px minmax(0, 1fr); gap: 32px; }
@media (max-width: 960px) { .case-body { grid-template-columns: 1fr; } .toc ol { display: flex; flex-wrap: wrap; } }
/* 640 以下流程块竖排 */
@media (max-width: 640px) { .flow { flex-direction: column; } }
/* 2400 以上整页放大，不再加宽 */
@media (min-width: 2400px) { body { zoom: 1.2; } }`;

const SRCSET = `srcset="p400.jpg 400w, p800.jpg 800w, p1200.jpg 1200w, p1600.jpg 1600w, p2400.jpg 2400w"
sizes="(max-width: 640px) calc(100vw - 32px), (max-width: 960px) 88vw, 60vw"
# srcset：有哪几张，各多少像素宽（w）
# sizes：这张图在页面上大概显示多宽；从左往右，第一个条件成立的就用它
# 浏览器拿显示宽度 × devicePixelRatio，挑够用的最小一张`;

const KEYJS = `// 非要用 span 做按钮，这些都得自己补：
el.setAttribute("role", "button");      // 读屏才知道它是按钮
el.tabIndex = 0;                         // Tab 才到得了
el.addEventListener("keydown", (e) => {  // Enter、空格才会触发
  if (e.key === "Enter" || e.key === " ") { e.preventDefault(); el.click(); }
});
// 还有禁用状态、表单里的提交行为……用 button 标签，这些都自带`;

const MOTIONCSS = `/* components.css：系统设置了“减少动态效果”，动画里的元素直接跳到位，不滑过去 */
@media (prefers-reduced-motion: reduce) { .mini .it, .mini .bx { transition: none; } }`;

