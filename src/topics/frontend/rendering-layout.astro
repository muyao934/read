// 什么挡住第一次显示：样式表挡显示、普通脚本挡解析；预加载扫描器照样往下找；defer、async
const BLOCK = {
  h: 300,
  b: [["pa", 2, 8, 30, 84, "解析器"], ["nw", 35, 8, 30, 84, "网络"], ["sc", 68, 8, 30, 84, "屏幕"]],
  it: [
    { id: "msg", h: chip("link 样式表", "--muted", "out"), x: 17, y: 30 },
    { id: "css", h: lbl("下载 CSS<br>（晚 1 秒）", "m"), x: 50, y: 58, hide: 1 },
    { id: "js", h: lbl("预加载扫描器：<br>后面的 JS 也下", "m"), x: 50, y: 82, hide: 1 },
