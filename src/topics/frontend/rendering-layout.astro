    { c: "解析器停着，预加载扫描器还在往后看源码，找到后面的脚本、图片就先去下载。实测两个各晚 1 秒的同步脚本，几乎同时开始、同时到达：一共 1 秒，不是 2 秒。",
      set: { js: { hide: 0 } }, lit: ["nw"] },
    { c: "defer 的脚本边解析边下载，解析完才按顺序执行：不挡显示（FCP 24 毫秒），但 DOMContentLoaded 要等它。async 下载完就执行，谁也不等：FCP 20 毫秒，DOMContentLoaded 5 毫秒。type=module 默认就和 defer 一样。",
      set: { msg: { h: chip("defer / async", "--accent") }, blank: { h: lbl("照常显示", "g") }, dom: { hide: 0 } }, lit: ["pa", "sc"] },
  ],
};

// Flex 怎么分空间：先定基准尺寸，再分剩下的（或分摊溢出的），最后被最小尺寸卡住。数字都是实测
const FLEX = {
  h: 300,
  b: [["g", 2, 6, 96, 27, "放大：分剩下的空间"], ["k", 2, 37, 96, 27, "缩小：按基准尺寸分摊"], ["m", 2, 68, 96, 27, "最小尺寸卡住"]],
  it: [
    { id: "g1", h: chip("flex: 1，600 宽", "--muted", "out"), x: 30, y: 22 },
    { id: "g2", h: lbl("300 · 300", "g"), x: 74, y: 22, hide: 1 },
    { id: "k1", h: chip("基准 400 和 200", "--muted", "out"), x: 30, y: 53 },
    { id: "k2", h: lbl("200 · 100", "g"), x: 74, y: 53, hide: 1 },
    { id: "m1", h: chip("flex: 1 + 长网址", "--muted", "out"), x: 30, y: 84 },
    { id: "m2", h: lbl("389.8 · 16", "w"), x: 74, y: 84, hide: 1 },
  ],
