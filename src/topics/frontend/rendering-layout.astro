      set: { g1: { h: chip("flex: auto", "--accent") }, g2: { h: lbl("172 · 428", "g") } }, lit: ["g"] },
    { c: "缩小反过来：基准 400 和 200 的两项挤进 300 宽，溢出 300。规范规定按“缩小系数 × 基准尺寸”分摊，400 那项摊 2 份、200 那项摊 1 份：各减 200 和 100。实测 200、100。",
      set: { k1: { h: chip("基准 400 和 200", "--accent") }, k2: { hide: 0 } }, lit: ["k"] },
    { c: "可是缩小有底线。flex 项目的 min-width 默认是 auto：不小于内容里最长的、断不开的那一段。一个长网址断不开，这一项最窄 389.8，另一项只剩 16，整行溢出 300 宽的容器 106。",
      set: { m1: { h: chip("flex: 1 + 长网址", "--warn") }, m2: { hide: 0 } }, bad: ["m"] },
    { c: "给项目加 min-width: 0，底线没了：实测回到 150、150（网址在自己的格子里溢出）。或者让网址能断：overflow-wrap: anywhere 也是 150、150。break-word 不行，实测还是 389.8：规范写明它断开的地方不算进最小尺寸。",
      set: { m1: { h: chip("min-width: 0", "--ok") }, m2: { h: lbl("150 · 150", "g") } }, lit: ["m"] },
    { c: "Grid 一模一样：1fr 其实是 minmax(auto, 1fr)，带着同样的自动最小值，实测 1fr 1fr 也是 389.8 和 16。写成 minmax(0, 1fr) 才平分。这个站的卡片、目录栏旁的正文，都是这样写的。",
      set: { m1: { h: chip("grid 1fr 1fr", "--warn") }, m2: { h: lbl("389.8 · 16", "w") } }, bad: ["m"] },
  ],
};

// 改了样式以后，下一帧哪几步要重做：2000 行的列表改一行，跟踪里各阶段出现与否
const STAGE = {
  h: 300,
  b: [["st", 2, 8, 22, 84, "样式"], ["ly", 27, 8, 22, 84, "布局"], ["pt", 52, 8, 22, 84, "绘制"], ["cp", 77, 8, 21, 84, "合成"]],
