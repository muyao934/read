// 前端与设计 · 第 1 章（概念类）：why → core → how → block → box → flex → grid → reflow → example → pitfalls → sources
// 2026-11-10 在本机 Chrome 157（headless）里实测：本机起服务器、故意延迟资源，用 DevTools 协议读时间、尺寸和跟踪
import { Section, Note, Cards, Card, Flow, Table, Code, Anim, Sources } from "../../components/index.js";
import { chip, lbl } from "../../lib/anim.js";

// 从字节到像素：本页在本机加载一次的跟踪，各阶段的实测耗时
