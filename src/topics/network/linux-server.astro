// unit 文件：systemd 只认行首的 # 注释，所以注释都单独占一行
const UNITFILE = `# /etc/systemd/system/app.service
[Unit]
Description=My app

[Service]
# 用专门的用户跑，不用 root
User=app
WorkingDirectory=/opt/app
ExecStart=/opt/app/bin/server --listen 127.0.0.1:3000
# 退出码非 0、被信号杀死等情况重启；等 2 秒再拉起
Restart=on-failure
RestartSec=2
# 密钥放在单独的文件里：由 systemd（root）读取，文件可以是 600 root:root
EnvironmentFile=/etc/app/secrets.env

[Install]
WantedBy=multi-user.target`;

const SYSTEMCTL = `sudo systemctl daemon-reload          # 改了 unit 文件以后
sudo systemctl enable --now app       # 开机自启，并且现在就启动
systemctl status app                  # 状态、PID、最近几行日志
sudo systemctl restart app            # 停了再启动
sudo systemctl reload nginx           # 让 Nginx 重读配置，不断开连接
systemctl list-timers                 # 定时任务，certbot 的续期可能在这里
journalctl -u app -e                  # 这个服务的日志，跳到最后
journalctl -u app -f                  # 跟着看新写进来的
journalctl -u app -b                  # 只看这次开机以来的
journalctl -u app -p err --since today   # 今天的、错误级别以上的`;

const NGINXCONF = `server {
    listen 80;
    server_name read.example.com;
    root /var/www;                          # /read/x.html → /var/www/read/x.html

    location = / { return 301 /read/; }
    location /read/ { try_files $uri $uri/ =404; }

    # 动态的部分转给只听本机的应用
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}`;

