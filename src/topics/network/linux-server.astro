// 照官方文档写的上线顺序，没有在真机上跑过；每一步验证完再走下一步
const DEPLOY = `# 0. 用服务商给的 root 和密钥登录
ssh root@203.0.113.10

# 1. 建自己的账号，能 sudo，能用同一把公钥登录
adduser deploy                          # 会问一个密码：之后 sudo 要用
usermod -aG sudo deploy
install -d -m 700 -o deploy -g deploy /home/deploy/.ssh
install -m 600 -o deploy -g deploy /root/.ssh/authorized_keys /home/deploy/.ssh/
# 另开一个窗口：ssh deploy@203.0.113.10，sudo -v 能过，再往下

# 2. 只许钥匙登录（这个窗口别关）
printf 'PasswordAuthentication no\\nKbdInteractiveAuthentication no\\nPermitRootLogin no\\n' \\
  | sudo tee /etc/ssh/sshd_config.d/10-hardening.conf
sudo sshd -T | grep -E '^(passwordauthentication|kbdinteractiveauthentication|permitrootlogin) '
sudo sshd -t && sudo systemctl reload ssh
# 再开一个窗口：钥匙能登录；ssh -o PubkeyAuthentication=no deploy@203.0.113.10 应该被拒

# 3. 防火墙：先放行，再打开
sudo ufw allow 22/tcp && sudo ufw allow 80/tcp && sudo ufw allow 443/tcp
sudo ufw enable

# 4. Nginx 和网站文件
sudo apt update && sudo apt install -y nginx
sudo install -d -o deploy -g deploy /var/www/read
# 在自己电脑上：npm run build，再把 dist/ 传上去
rsync -av --delete dist/ deploy@203.0.113.10:/var/www/read/
# 回到服务器：写 /etc/nginx/sites-available/read（内容见“用 Nginx 上线”一节），再启用
sudo ln -s /etc/nginx/sites-available/read /etc/nginx/sites-enabled/
sudo nginx -t && sudo systemctl reload nginx
curl -sI -H 'Host: read.example.com' http://127.0.0.1/read/ | head -1

# 5. 证书（先把域名的 A 记录指到 203.0.113.10）
sudo apt install -y certbot python3-certbot-nginx
sudo certbot --nginx -d read.example.com
sudo certbot renew --dry-run`;

