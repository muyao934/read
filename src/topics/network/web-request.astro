    { id: "a3", h: lbl("185.199.108.153", "m"), x: 84, y: 24 },
    { id: "pk", h: chip("包", "--muted", "out"), x: 15, y: 46 },
    { id: "tb", h: lbl("记一笔：40001 ↔<br>192.168.1.23:52001", "m"), x: 49, y: 70, hide: 1 },
    { id: "drop", h: lbl("表里没有：丢掉", "w"), x: 49, y: 70, hide: 1 },
