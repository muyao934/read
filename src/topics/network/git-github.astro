    { id: "ev", h: lbl("push 到 main<br>触发 Deploy", "m"), x: 38, y: 60, hide: 1 },
    { id: "st", h: lbl("装依赖、构建<br>跑检查：17 秒", "m"), x: 63, y: 60, hide: 1 },
    { id: "ok", h: lbl("上线：8 秒", "g"), x: 88, y: 60, hide: 1 },
  ],
  s: [
    { c: "你 git push 到 main。到这一步，提交才离开你的电脑。", lit: ["me"] },
