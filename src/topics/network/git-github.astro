    { id: "mm", h: chip("M（两个父提交）", "--ok"), x: 66, y: 30, hide: 1 },
    { id: "ra", h: chip("A · B · C"), x: 18, y: 66 },
    { id: "rx", h: chip("X · Y", "--accent", "out"), x: 18, y: 82 },
    { id: "rr", h: chip("C → X′ → Y′", "--ok"), x: 66, y: 74, hide: 1 },
  ],
  s: [
