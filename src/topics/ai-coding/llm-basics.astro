// 2026-11-09 由原第 01 章（大模型怎么写代码）和第 02 章（Agent 是什么）合并，旧网址 agent-loop.html 跳到 #agent
import { Section, Note, Cards, Card, Flow, Table, Code, Anim, Sources } from "../../components/index.js";
import { chip, lbl } from "../../lib/anim.js";

// 预测下一个 token 的循环；后半段演示信息缺失时怎么“编”出一个函数名。概率是示意值
const LOOP = {
  h: 300,
  b: [["ctx", 2, 8, 96, 26, "上下文：模型此刻看得到的全部内容"], ["mdl", 2, 42, 44, 50, "模型"], ["cand", 54, 42, 44, 50, "下一个 token 的候选"]],
  it: [
    { id: "code", h: chip("function add(a, b)", "--muted", "out"), x: 50, y: 22 },
    { id: "mt", h: lbl("对每个可能的 token<br>算出概率", "m"), x: 24, y: 68, hide: 1 },
