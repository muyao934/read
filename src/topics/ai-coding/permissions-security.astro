// 改写自官方 hooks 指南的例子。用普通字符串拼：模板字符串会把 \${…} 当成插值
const SCRIPT = ["#!/bin/bash",
  "# .claude/hooks/protect-files.sh：改到受保护的文件就拦住",
  "INPUT=$(cat)                                   # Claude Code 从标准输入传来这次调用的 JSON",
  "FILE_PATH=$(echo \"$INPUT\" | jq -r '.tool_input.file_path // empty')",
  "PROTECTED=(\".env\" \"package-lock.json\" \".git/\")",
  "for pattern in \"${PROTECTED[@]}\"; do",
  "  if [[ \"$FILE_PATH\" == *\"$pattern\"* ]]; then",
  "    echo \"Blocked: $FILE_PATH matches '$pattern'\" >&2   # 原因写到 stderr，会发给 Claude",
