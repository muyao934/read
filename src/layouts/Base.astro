---
// 全站外壳：<head>、顶栏、主题按钮、页脚。首页和文章页都用它，不在页面里另写。
// 主题和区块链站共用 localStorage 键 chronicle-theme，切换后两边一致。
// 底层样式直接用区块链站的 base.css（2026-11-08 起不再留副本）：两边只有一套设计，改一处两边同时生效
import "../../blockchain/shared/base.css";
import "../styles/components.css";
import "../styles/lib.css";
import { url } from "../lib/url.js";
// skip：正文元素的 id。给了就在页首放一个“跳到正文”，平时藏在屏幕外，按 Tab 到它才出现（文章和章节页传入；首页只有两个顶栏按钮，不放）
const { title, desc, bodyClass = "", skip } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={desc}>
<script is:inline>
  // 绘制前套上主题，避免闪一下
  (function () {
    try { var t = localStorage.getItem("chronicle-theme"); if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t); } catch (e) {}
  })();
</script>
</head>
<body class={bodyClass}>
{skip && <a class="skip-link" href={`#${skip}`}>跳到正文</a>}
<header class="topbar"><div class="wrap">
  <a class="home" href={url("index.html")}>阅读库</a>
  <button type="button" class="theme-toggle" id="theme-toggle">主题：跟随系统</button>
</div></header>
<slot />
<footer class="site-foot"><div class="wrap"><slot name="foot" /></div></footer>
<script is:inline>
  (function () {
    var KEY = "chronicle-theme", L = { auto: "主题：跟随系统", light: "主题：浅色", dark: "主题：深色" };
    var btn = document.getElementById("theme-toggle"), cur = "auto";
    try { cur = localStorage.getItem(KEY) || "auto"; } catch (e) {}
    btn.textContent = L[cur] || L.auto;
    btn.addEventListener("click", function () {
      cur = cur === "auto" ? "light" : cur === "light" ? "dark" : "auto";
      try { localStorage.setItem(KEY, cur); } catch (e) {}
      if (cur === "auto") document.documentElement.removeAttribute("data-theme");
      else document.documentElement.setAttribute("data-theme", cur);
      btn.textContent = L[cur];
    });
  })();
</script>
</body>
</html>
